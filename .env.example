# Plantilla de configuracion local.
#
# Copia este fichero a `.env` y rellena los valores. `.env` esta en
# `.gitignore` y no debe subirse nunca al repositorio.

# --- Base de datos ---------------------------------------------------------
#
# MySQL o MariaDB local. La contrasena va codificada si lleva `@` o `:`.
#
#   usuario:sin-contrasena@host:puerto/base
#
# Esta es la unica variable que usa tanto `prisma migrate` como la aplicacion:
# no hay usuario ni host escritos en el codigo.
DATABASE_URL="mysql://root:TU_CONTRASENA@localhost:3306/pingo_pop"

# --- Sesion ----------------------------------------------------------------
#
# Secreto con el que se firma la cookie de sesion (HMAC-SHA256).
#
# Genera uno de 32 bytes o mas, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Sin esto la aplicacion no arranca. Nunca reutilices el valor de otro entorno:
# con el mismo secreto, una cookie de desarrollo es valida en produccion.
SESSION_SECRET="pega-aqui-el-resultado-de-randomBytes"

# --- Administrador inicial (solo para `npm run db:seed`) -------------------
#
# El seed crea esta cuenta con rol ADMIN. La contrasena se hashea con argon2id
# antes de tocar la base de datos, nunca en claro.
#
# El login exige 8 caracteres como minimo: por menos, la cuenta se crearia sin
# poder entrar. El seed avisa (no bloquea) si no cumple la politica de 12 con
# minuscula, mayuscula y digito. Usa una larga y cambiala antes de desplegar.
ADMIN_EMAIL="admin@pingo-pop.local"
ADMIN_PASSWORD="pon-aqui-una-contrasena-de-8-o-mas"

# --- MariaDB en Docker (solo para `docker compose up`) ---------------------
#
# `docker-compose.yml` lee estas variables del `.env` del proyecto. Sin valor
# por defecto a proposito: si faltan, compose falla en vez de levantar MariaDB
# con una contrasena vacia. `DB_PASSWORD` debe coincidir con la contrasena que
# aparece en `DATABASE_URL` (es el mismo usuario `pingo`).
MARIADB_ROOT_PASSWORD="cambia-esta-contrasena-root"
MARIADB_DATABASE="pingo_pop"
DB_USER="pingo"
DB_PASSWORD="cambia-esta-contrasena"
