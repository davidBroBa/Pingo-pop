generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  BUYER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(BUYER)
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Se incrementa cada vez que se cambia la contrasena. Viaja dentro de la cookie
  // firmada como `sv` y se compara contra este valor al pedir datos, de modo que
  // cambiar la contrasena deja invalidas todas las sesiones (spec 006).
  sessionVersion Int @default(0)

  // La cuenta **nace** con la contrasena que le puso un administrador y esta
  // marcada para cambiarla (spec 007, D21). Se relee de la base de datos en
  // `getSessionUser()`, igual que el rol: la cookie firmada lleva el distintivo
  // para que el `proxy` decida rapido, y aqui manda la verdad.
  //
  // El `@default(false)` no es opcional: `STRICT_TRANS_TABLES` falla al anadir un
  // `NOT NULL` sin defecto a una tabla que ya tiene filas.
  debeCambiarContrasena Boolean @default(false)

  // Desactivar en vez de borrar (spec 007, D23). Desactivar **tambien** incrementa
  // `sessionVersion`, y por eso quita el acceso de verdad: toda cookie emitida
  // antes queda en una version anterior.
  //
  // La unica relacion de `User` en el esquema es `legalAcceptances` (spec 010), y
  // es con `SetNull`: borrar una fila no romperia nada tecnicamente, pero esta
  // spec **no borra cuentas** igualmente: se perderia el registro de que existieron,
  // y no hay log de auditoria que lo reconstruya.
  activo Boolean @default(true)

  // Aceptaciones legales ligadas a la cuenta (spec 010, D28). `SetNull` en la
  // columna: la evidencia sobrevive al borrado de la cuenta, porque no contiene
  // datos personales.
  legalAcceptances LegalAcceptance[]
}

/**
 * Ajustes del sitio. **Una sola fila**, no una tabla de configuraciones libre.
 *
 * El `id` fijo a 1 no se elige por comodidad: hace imposible el error clasico
 * de estas tablas, que es crear una fila nueva cada vez que se guarda algo y
 * acabar leyendo un valor al azar. Si la fila no existe, `writeHeroImage()`
 * la crea con `upsert` y no hay paso de siembra que se pueda saltar.
 *
 * Cuando haga falta guardar mas cosas del sitio (un banner, un telefono, un
 * texto de pie) se **anaden columnas aqui**, no filas: el motivo de que sea
 * singleton se pierde en cuanto se llena.
 */
model SiteSettings {
  id Int @id @default(1)

  // Ruta de la foto del hero, dentro de `/uploads/site/`. Valida `siteImagePath`
  // en `src/lib/validation.ts`, no `imagePath`: el hero no es un producto y no
  // puede apuntar a la carpeta del catalogo.
  heroImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Datos legales del responsable (spec 009, RF-1, D18).
 *
 * **Una sola fila**, con `id` fijo a `1`, igual que `SiteSettings`: el id fijo y el
 * `upsert` son lo que impiden el error de crear una fila por guardado y acabar
 * leyendo un valor al azar. **No hay paso de siembra**: la fila aparece la primera
 * vez que el administrador guarda.
 *
 * Los seis campos son **opcionales a proposito**. Los rellena una persona desde
 * `/admin/legal` (D18), no una variable de entorno, para que no haga falta SSH. Un
 * campo ausente **no** se sustituye por un valor inventado: las paginas muestran el
 * marcador `MARCADOR_PENDIENTE` de `src/lib/legal-data.ts` en su lugar (RF-2).
 */
model LegalData {
  id Int @id @default(1)

  razonSocial           String?
  rfc                   String?
  domicilioFiscal       String?  @db.Text
  correoContacto        String?
  telefono              String?
  responsablePrivacidad String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Evidencia de que alguien acepto una version de un documento (spec 009, RF-19;
 * ampliado en spec 010, D28).
 *
 * Se guarda **cinco** campos y ni uno mas (RF-20). En concreto, **no** guarda IP,
 * ni nombre, ni correo: el vinculo con la persona ya existe a traves de
 * `quoteRequestId` o `userId`, y duplicar esos datos seria recolectar sin
 * finalidad, que es justo lo que este proyecto quiere evitar.
 */
model LegalAcceptance {
  id         Int           @id @default(autoincrement())
  tipo       LegalDocType
  version    String
  aceptadoAt DateTime      @default(now())

  // Opcional a proposito, y con `SetNull` en vez de `Cascade`: si se borra el
  // usuario o la solicitud (retencion o cancelacion), **el registro de aceptacion
  // sobrevive**. Puede, porque no contiene ningun dato personal: `tipo`, `version`
  // y `aceptadoAt` siguen siendo prueba de que version estaba vigente. Un
  // `Cascade` lo borraria, y con el la unica evidencia de que se acepto.
  // `userId` llego con la spec 010 (registro publico): alla no existe todavia
  // `quoteRequestId`, y sin la columna la aceptacion del alta no quedaria en
  // ningun sitio.
  userId          Int?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  quoteRequestId  Int?
  quoteRequest    QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  @@index([tipo, version])
  @@index([quoteRequestId])
  @@index([userId])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  quoteRequestItems QuoteRequestItem[]
}

/**
 * Estado de una solicitud de cotizacion (spec 009, RF-26).
 *
 * Antes era un `String` libre que **nadie leia ni escribia**: se creaba como
 * `PENDING` y se quedaba ahi para siempre. Con enumeracion, el panel puede
 * filtrar por estado y la retencion puede distinguir una conversacion en curso de
 * una terminada.
 *
 * Los **terminales** son `ACCEPTED`, `REJECTED` y `CANCELLED`, y son los unicos que
 * pueden marcarse por antiguedad (ver `MESES_RETENCION` en `src/lib/retention.ts`).
 */
enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  CANCELLED
}

/**
 * Documento legal sobre el que alguien acepta o no (spec 009, RF-20).
 *
 * Solo los **tres** que llevan consentimiento. Los otros cuatro documentos
 * (envios, devoluciones, informacion legal y accesibilidad) se publican, pero no se
 * "aceptan" con un clic: no hay una decision que registrar.
 */
enum LegalDocType {
  TERMINOS
  PRIVACIDAD
  COOKIES
}

model QuoteRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String
  details   String   @db.Text
  status    QuoteStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Token que genera el cliente para que dos envios seguidos **no** creen dos
  // solicitudes (RF-27). Es unico y opcional: las peticiones antiguas, que no lo
  // traian, siguen siendo validas.
  idempotencyKey String? @unique

  items            QuoteRequestItem[]
  legalAcceptances LegalAcceptance[]
}

model QuoteRequestItem {
  id             Int @id @default(autoincrement())
  quantity       Int @default(1)
  productId      Int
  quoteRequestId Int

  product      Product      @relation(fields: [productId], references: [id])
  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  createdAt DateTime @default(now())
}