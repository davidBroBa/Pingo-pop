generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  BUYER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(BUYER)
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Se incrementa cada vez que se cambia la contrasena. Viaja dentro de la cookie
  // firmada como `sv` y se compara contra este valor al pedir datos, de modo que
  // cambiar la contrasena deja invalidas todas las sesiones (spec 006).
  sessionVersion Int @default(0)
}

/**
 * Ajustes del sitio. **Una sola fila**, no una tabla de configuraciones libre.
 *
 * El `id` fijo a 1 no se elige por comodidad: hace imposible el error clasico
 * de estas tablas, que es crear una fila nueva cada vez que se guarda algo y
 * acabar leyendo un valor al azar. Si la fila no existe, `writeHeroImage()`
 * la crea con `upsert` y no hay paso de siembra que se pueda saltar.
 *
 * Cuando haga falta guardar mas cosas del sitio (un banner, un telefono, un
 * texto de pie) se **anaden columnas aqui**, no filas: el motivo de que sea
 * singleton se pierde en cuanto se llena.
 */
model SiteSettings {
  id Int @id @default(1)

  // Ruta de la foto del hero, dentro de `/uploads/site/`. Valida `siteImagePath`
  // en `src/lib/validation.ts`, no `imagePath`: el hero no es un producto y no
  // puede apuntar a la carpeta del catalogo.
  heroImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  quoteRequestItems QuoteRequestItem[]
}

model QuoteRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String
  details   String   @db.Text
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteRequestItem[]
}

model QuoteRequestItem {
  id             Int @id @default(autoincrement())
  quantity       Int @default(1)
  productId      Int
  quoteRequestId Int

  product      Product      @relation(fields: [productId], references: [id])
  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  createdAt DateTime @default(now())
}